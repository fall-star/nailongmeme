---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoContent from '../components/SeoContent.astro';
import GalleryApp from '../components/GalleryApp.tsx';
import gallery from '../data/gallery.json';
import type { MemeItem } from '../lib/types';
const items = (gallery as { items: MemeItem[] }).items.filter((item) => item.tag.includes('奶蛙'));
const tags = [...new Set(items.flatMap((item) => item.tag))];
---
<BaseLayout
  title="奶蛙表情包大全_免费下载 - 奶龙表情库"
  description="奶蛙表情包合集：聊天斗图、表达情绪和日常互动。可按标签筛选，支持在线预览和免费单张下载。"
  keywords="奶蛙,奶蛙表情包,奶蛙表情包大全,奶龙表情库,奶蛙图片"
  active="naiwa"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '奶蛙表情包大全',
    description: '奶蛙表情包合集，支持搜索、标签筛选、在线预览和免费单张下载。',
    url: 'https://nailong.fall-star.top/naiwa',
    inLanguage: 'zh-CN',
  }}
>
  <GalleryApp client:only="react" initialTag="奶蛙" basePath="/naiwa" allowedTags={tags} hideHero categoryTitle="奶蛙表情包" categoryDesc={`${items.length} 张奶蛙表情包。点下面的标签继续筛选，不会跳回首页。`} />
  <SeoContent variant="naiwa" />
</BaseLayout>
