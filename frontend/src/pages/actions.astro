---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoContent from '../components/SeoContent.astro';
import GalleryApp from '../components/GalleryApp.tsx';
import categories from '../data/tag-categories.json';
---
<BaseLayout
  title="奶龙表情包动作专区_跳舞加冕比心 - 奶龙表情库"
  description="按加冕、跳舞、拳击、比心、鼓掌等动作标签筛选奶龙表情包和奶蛙表情包。"
  keywords="奶龙表情包,奶蛙表情包,动作表情包,跳舞表情包"
  active="action"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '奶龙表情包动作专区',
    description: '按动作标签筛选奶龙表情包和奶蛙表情包。',
    url: 'https://nailong.fall-star.top/actions',
    inLanguage: 'zh-CN',
  }}
>
  <GalleryApp client:only="react" basePath="/actions" allowedTags={categories.action} onlyAllowedTags hideHero categoryTitle="动作专区" categoryDesc="这里只保留动作相关标签。点标签后会在本页直接显示结果。" />
  <SeoContent variant="actions" />
</BaseLayout>
