---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoContent from '../components/SeoContent.astro';
import GalleryApp from '../components/GalleryApp.tsx';
import gallery from '../data/gallery.json';
import type { MemeItem } from '../lib/types';
const items = (gallery as { items: MemeItem[] }).items.filter((item) => item.tag.includes('奶龙'));
const tags = [...new Set(items.flatMap((item) => item.tag))];
---
<BaseLayout
  title="奶龙表情包大全_免费下载 - 奶龙表情库"
  description="奶龙表情包合集：日常聊天、搞笑、生气、委屈、睡觉等场景。可按标签筛选，支持在线预览和免费单张下载。"
  keywords="奶龙,奶龙表情包,奶龙表情包大全,奶龙表情库,奶龙图片"
  active="nailong"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '奶龙表情包大全',
    description: '奶龙表情包合集，支持搜索、标签筛选、在线预览和免费单张下载。',
    url: 'https://nailong.fall-star.top/nailong',
    inLanguage: 'zh-CN',
  }}
>
  <GalleryApp client:only="react" initialTag="奶龙" basePath="/nailong" allowedTags={tags} hideHero categoryTitle="奶龙表情包" categoryDesc={`${items.length} 张奶龙表情包。所有未标记「奶蛙」的图片都归入奶龙。`} />
  <SeoContent variant="nailong" />
</BaseLayout>
