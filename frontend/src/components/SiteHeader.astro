---
import AuthMenu from './AuthMenu';
const { active = 'all' } = Astro.props;
const nav = [
  { key: 'all', label: '全部', href: '/' },
  { key: 'naiwa', label: '奶蛙', href: '/naiwa' },
  { key: 'nailong', label: '奶龙', href: '/nailong' },
  { key: 'mood', label: '情绪', href: '/mood' },
  { key: 'action', label: '动作', href: '/actions' },
  { key: 'tags', label: '标签', href: '/tags' },
];
---
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/" aria-label="奶龙表情库首页">
      <span class="brand-mark">奶</span>
      <span><span class="brand-name">奶龙表情库</span><span class="brand-sub">NAILONG MEME ARCHIVE</span></span>
    </a>
    <nav class="main-nav" aria-label="主导航">
      {nav.map((item) => (
        <a class:list={['nav-link', { active: active === item.key }]} href={item.href}>{item.label}</a>
      ))}
    </nav>
    <form class="top-search" action="/" method="get" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 20 20"/></svg>
      <input type="search" name="q" placeholder="搜表情、找心情…" aria-label="搜索表情">
    </form>
    <div class="header-actions">
      <a class="icon-btn random-top" href="/?random=1" title="随机一张" aria-label="随机一张">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/></svg>
      </a>
      <a class="icon-btn github-link" href="https://github.com/fall-star/nailongmeme" target="_blank" rel="noopener noreferrer" title="GitHub 仓库" aria-label="GitHub 仓库">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.2c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.19-3.11-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.19a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.19 3.17-1.19.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.11 0 4.45-2.7 5.43-5.28 5.72.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
      </a>
      <a class="api-docs-link" href="/api-docs" title="API 文档" aria-label="API 文档">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 7 4 12l5 5M15 7l5 5-5 5M13 5l-2 14"/></svg>
        <span class="api-docs-label">API 文档</span>
      </a>
      <AuthMenu client:load />
    </div>
  </div>
</header>
<script is:inline>
  const search = new URLSearchParams(window.location.search).get('q');
  if (search) {
    document.querySelectorAll('input[name="q"]').forEach((input) => {
      input.value = search;
    });
  }
</script>
