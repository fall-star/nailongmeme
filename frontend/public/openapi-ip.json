    "/api/search/list": {
      "get": {
        "summary": "Multi-result keyword search metadata (ranked; no random fallback)",
        "operationId": "search_list_api_search_list_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Q"
            }
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "default": 0.8,
              "title": "Min Score"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 40,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search parameters."
          }
        },
        "tags": [
          "Search"
        ],
        "description": "Ranked multi-result search. Returns an empty items array and fallback=true when there is no match; it does not silently return a random image.",
        "x-rate-limit": "20 requests/second per client IP, burst 40, enforced by Nginx."
      }
    },
    "/api/search": {
      "get": {
        "summary": "Keyword search: return the matched image bytes",
        "operationId": "search_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Keyword or Chinese homophone",
              "title": "Q"
            },
            "description": "Keyword or Chinese homophone"
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "description": "Below this score, return a random image",
              "default": 0.8,
              "title": "Min Score"
            },
            "description": "Below this score, return a random image"
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.5,
              "minimum": 0,
              "description": "Randomize among scores within this window of the best",
              "default": 0.04,
              "title": "Window"
            },
            "description": "Randomize among scores within this window of the best"
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional seed for reproducible random selection",
              "title": "Seed"
            },
            "description": "Optional seed for reproducible random selection"
          },
          {
            "name": "stable",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Choose the lowest id in the top group instead of random",
              "default": false,
              "title": "Stable"
            },
            "description": "Choose the lowest id in the top group instead of random"
          }
        ],
        "responses": {
          "200": {
            "description": "Raw JPG/GIF image bytes.",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search parameters."
          }
        },
        "tags": [
          "Search"
        ],
        "description": "Search and return the matched image as raw bytes. If no match reaches min_score, a random image is returned.",
        "x-rate-limit": "20 requests/second per client IP, burst 40, enforced by Nginx."
      }
    },
