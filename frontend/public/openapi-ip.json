{
  "openapi": "3.1.0",
  "info": {
    "title": "Nailong Meme Library API",
    "summary": "Read-only meme library API over HTTP on the production IP.",
    "description": "Read-only API for the Nailong / Naiwa meme library.\n\nProduction base URL: http://47.118.50.113/api\n\n- Image endpoints return JPG/GIF bytes only, never JSON.\n- Use /search/meta and /random/meta when metadata is required.\n- The public gallery exposes 1,164 entries. Seven entries are hidden by the review filter in data/review/sensitive.json.\n- Entries without a 奶蛙 tag are treated as 奶龙 at runtime.\n- No authentication is required. The production Nginx edge applies 20 requests/second per client IP with burst 40.\n- The API is HTTP-only while the custom domain is pending ICP filing; use the IP base URL above.",
    "version": "1.3.0",
    "license": {
      "name": "MIT",
      "url": "https://github.com/fall-star/nailongmeme/blob/main/LICENSE"
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health and library counts",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "System"
        ],
        "description": "Service health and current catalog counts.",
        "x-rate-limit": "20 requests/second per client IP, burst 40, enforced by Nginx."
      }
    },
    "/api/gallery": {
      "get": {
        "summary": "Public gallery metadata with thumbnails and pagination",
        "operationId": "gallery_api_gallery_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local name/tag substring filter",
              "title": "Q"
            },
            "description": "Local name/tag substring filter"
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact tag filter",
              "title": "Tag"
            },
            "description": "Exact tag filter"
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated tags; all must match",
              "title": "Tags"
            },
            "description": "Comma-separated tags; all must match"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(jpeg|gif)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Format"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 48,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "Gallery"
        ],
        "description": "Paginated public gallery metadata. The total excludes review-filtered entries.",
        "x-rate-limit": "20 requests/second per client IP, burst 40, enforced by Nginx."
      }
    },
