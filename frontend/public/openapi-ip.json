        "tags": [
          "Gallery"
        ],
        "description": "WebP card thumbnail. GIFs use the first frame; the original image remains at /api/images/{id}.",
        "x-rate-limit": "20 requests/second per client IP, burst 40, enforced by Nginx."
      }
